{
  "name": "synapse-dict",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @synapse-dict/api",
    "dev:web": "npm run dev --workspace @synapse-dict/web",
    "build": "npm run typecheck && npm run build --workspace @synapse-dict/web",
    "typecheck": "npm run typecheck --workspace @synapse-dict/api && npm run typecheck --workspace @synapse-dict/web",
    "start": "tsx apps/api/src/index.ts",
    "gate:fr-tags": "tsx scripts/contract/fr_tag_tables.ts",
    "gate:tags": "tsx scripts/contract/tag_coverage_all.ts",
    "gate:en-chips": "tsx scripts/contract/en_sense_chips.ts",
    "gate:service-api": "tsx scripts/contract/service_api.ts",
    "gate:ja-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-ja.tsx",
    "gate:ko-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-ko.tsx",
    "gate:ko-labels": "python3 ko/tests/test_display_labels.py",
    "gate:ko-plans": "python3 ko/probes/query_plans.py",
    "gate:vi-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-vi.tsx",
    "gate:vi-plans": "python3 vi/probes/query_plans.py",
    "gate:ru-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-ru.tsx",
    "gate:ru-plans": "python3 ru/probes/query_plans.py",
    "gate:audio-labels": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-audio.tsx",
    "gate:etym-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-etym.tsx",
    "gate:layout": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-layout.tsx",
    "gate:css-audit": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/css-audit.ts",
    "gate:dispatch-audit": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/dispatch-audit.ts",
    "gate:audio-dup": "python3 scripts/test_audio_dup_gate.py",
    "gate:redundant-related": "python3 -u scripts/test_redundant_related_gate.py",
    "gate:de-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-de.tsx",
    "gate:en-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-en.tsx",
    "gate:es-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-es.tsx",
    "gate:fr-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-fr.tsx",
    "gate:pt-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-pt.tsx",
    "gate:colloc-display": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-colloc.tsx",
    "gate:display": "python3 -u scripts/run_display_gates.py",
    "gate:first-build": "python3 -u scripts/test_first_build_gate.py",
    "gate:consult": "python3 scripts/consult.py --selftest",
    "gate:backlog": "python3 -u scripts/test_backlog_gate.py",
    "gate:backup-policy": "python3 -u scripts/test_backup_policy_gate.py",
    "gate:es-plans": "python3 scripts/query_plans_probe.py --lang es",
    "gate:fr-plans": "python3 scripts/query_plans_probe.py --lang fr",
    "gate:it-plans": "python3 scripts/query_plans_probe.py --lang it",
    "gate:page-timing": "tsx scripts/contract/page_timing.ts",
    "gate:overflow": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/contract-check-overflow.tsx"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.37.0"
  }
}
